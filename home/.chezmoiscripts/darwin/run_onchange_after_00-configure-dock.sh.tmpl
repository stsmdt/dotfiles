#!/bin/bash

set -eufo pipefail

trap 'killall Dock' EXIT

{{ $dockApps := list
     "/System/Applications/Messages.app/"
     "/Applications/WhatsApp.app"
     "/Applications/Discord.app"
     "space"
     "/Applications/Brave Browser.app"
     "/System/Applications/Utilities/Terminal.app"
     "/Applications/Visual Studio Code.app"
     "space"
     "/Applications/Pages Creator Studio.app"
     "/Applications/Numbers Creator Studio.app"
     "/Applications/Keynote Creator Studio.app"
     "space"
     "/Applications/Spotify.app"
     "/Applications/VLC.app" -}}

dockutil --no-restart --remove all

{{ range $dockApps }}
  {{- if ne . "space" -}}
  dockutil --no-restart --add  "{{ . }}"
  {{- else -}}
  dockutil --no-restart --add "" --type small-spacer --section apps
  {{- end }}
{{ end -}}
dockutil --no-restart --add "/Applications" --section others --display folder --view grid --sort name
